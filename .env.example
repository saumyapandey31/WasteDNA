# api (default) uses the Next.js backend. mock keeps analysis in the browser for offline demos.
NEXT_PUBLIC_ANALYSIS_MODE=api
# Optional external vision API. When both are set, /api/analyze calls it and falls back to the local pipeline on any error.
WASTE_VISION_API_URL=
WASTE_VISION_API_KEY=
# Optional: where the JSON store lives (default ./data)
WASTEDNA_DATA_DIR=
